# Copy to .env and adjust. See README.md for the full table.
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgis://primp:primp@localhost:5432/primp
DB_CONN_MAX_AGE=60
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Auth
JWT_SIGNING_KEY=change-me-too
ACCESS_TOKEN_MINUTES=15
ADMIN_ACCESS_TOKEN_MINUTES=5
REFRESH_TOKEN_DAYS=30
ADMIN_REFRESH_TOKEN_HOURS=8
REFRESH_COOKIE_NAME=primp_refresh
REFRESH_COOKIE_SECURE=True
REFRESH_CSRF_COOKIE_NAME=primp_csrf
REFRESH_TOKEN_IN_BODY=False
GOOGLE_CLIENT_IDS=
FRONTEND_URL=http://localhost:3000
FRONTEND_REVALIDATE_URL=
FRONTEND_REVALIDATE_SECRET=

# Messaging
SMS_ADAPTER=console
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=Primp
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
DEFAULT_FROM_EMAIL=Primp <no-reply@primp.pk>

# Object storage (set the bucket to enable S3/R2/MinIO)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Booking, reminders, payments
BOOKING_HOLD_SECONDS=300
REMINDER_24H_SECONDS=86400
REMINDER_2H_SECONDS=7200
REMINDER_GRACE_SECONDS=1800
PAYMENT_GATEWAY=fake
PAYMENT_WEBHOOK_SECRET=change-me-webhook

# Operations
THROTTLE_ANON=120/min
THROTTLE_USER=600/min
TRUSTED_PROXY_COUNT=0
API_DOCS_ENABLED=True
LOG_LEVEL=INFO
LOG_REDACT_PII=True
SENTRY_DSN=
NOTIFICATIONS_RAISE_ON_RENDER_ERROR=False
LOYALTY_RAISE_ON_ERROR=False
